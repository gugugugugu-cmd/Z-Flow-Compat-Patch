<?xml version="1.0" encoding="utf-8"?>
<!--
    沉浸式卡片化设置页：
    - 无 ActionBar，根布局 fitsSystemWindows 让内容下移避让状态栏，
      顶栏区域即背景色（沉浸式），下方为大标题（Large Title）+ 副标题
    - 浅灰背景 #F2F2F7，白色圆角卡片承载设置项
    - 设置项复用 SettingItem 布局（左侧图标 + 标题 + 描述，右侧 Switch 顶部对齐）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ============ 大标题区（Large Title） ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/title_large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:lineSpacingExtra="0dp" />

        <TextView
            android:id="@+id/title_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- ============ 可滚动内容 ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/screen_margin_top">

            <!-- ========== 卡片一：补丁开关 ========== -->
            <TextView
                style="@style/GroupTitle"
                android:text="@string/pref_group_patch" />

            <LinearLayout
                android:id="@+id/card_patch"
                style="@style/CardContainer"
                android:orientation="vertical">

                <include
                    android:id="@+id/item_wechat"
                    layout="@layout/item_setting_switch" />

                <View
                    style="@style/ItemDivider" />

                <include
                    android:id="@+id/item_statusbar"
                    layout="@layout/item_setting_switch" />

                <View
                    style="@style/ItemDivider" />

                <include
                    android:id="@+id/item_telegram"
                    layout="@layout/item_setting_switch" />
            </LinearLayout>

            <!-- ========== 卡片二：调试 ========== -->
            <TextView
                style="@style/GroupTitle"
                android:text="@string/pref_group_debug" />

            <LinearLayout
                android:id="@+id/card_debug"
                style="@style/CardContainer"
                android:orientation="vertical">

                <include
                    android:id="@+id/item_verbose"
                    layout="@layout/item_setting_switch" />

                <View
                    style="@style/ItemDivider" />

                <include
                    android:id="@+id/item_log"
                    layout="@layout/item_setting_switch" />
            </LinearLayout>

            <!-- ========== 卡片三：关于 ========== -->
            <TextView
                style="@style/GroupTitle"
                android:text="@string/pref_group_about" />

            <LinearLayout
                android:id="@+id/card_about"
                style="@style/CardContainer"
                android:orientation="vertical">

                <include
                    android:id="@+id/item_about"
                    layout="@layout/item_setting_about" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

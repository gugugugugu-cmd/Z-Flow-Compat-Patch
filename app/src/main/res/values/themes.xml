<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        沉浸式无 ActionBar 主题（API 26 基础版）：
        - 去掉大面积深蓝顶栏（DarkActionBar），页面背景交给浅灰 page_background，
          顶栏区域与背景同色，由状态栏微调色接管。
        - colorControlActivated = 品牌深蓝，Switch 开启态即为此色。
        - API 26 无浅色导航栏支持：导航栏用深色，避免浅灰底 + 白图标看不清；
          API 27+ 的浅色版本见 values-v27/themes.xml。
    -->
    <style name="Theme.CompatPatch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="colorControlActivated">@color/brand</item>
        <item name="colorSwitchThumbNormal">@color/switch_off_thumb</item>
        <item name="android:colorBackground">@color/page_background</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/text_primary</item>
    </style>
</resources>
